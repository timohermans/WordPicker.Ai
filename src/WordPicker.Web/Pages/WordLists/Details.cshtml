@page
@model WordPicker.Web.Pages.WordLists.DetailsModel
@{
    ViewData["Title"] = Model.WordList?.Name;
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @errorMessage
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@if (Model.WordList != null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1>@Model.WordList.Name</h1>
        <a asp-page="./Index" class="btn btn-outline-secondary">Back to Lists</a>
    </div>

    <h2>Add a Word</h2>
    <form method="post" asp-page-handler="AddWord" asp-route-id="@Model.WordList.Id" class="mb-4">
        <div class="row g-2">
            <div class="col-md-8">
                <input asp-for="NewWord" class="form-control" placeholder="Enter a new word" required autofocus/>
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100">Add Word</button>
            </div>
        </div>
    </form>

    <h2>Words</h2>
    @if (!Model.WordList.Words.Any())
    {
        <div class="alert alert-info">
            <p>No words in this list yet. Add your first word above!</p>
        </div>
    }
    else
    {
        <ul class="list-group">
            @foreach (var word in Model.WordList.Words)
            {
                <li class="list-group-item d-flex justify-content-between align-items-center">
                    <span>@word.Value</span>
                    <form method="post" asp-page-handler="RemoveWord" asp-route-id="@Model.WordList.Id" asp-route-wordId="@word.Id" class="d-inline"
                          onsubmit="return confirm('Are you sure you want to remove this word?');">
                        <button type="submit" class="btn btn-sm btn-outline-danger">
                            Remove
                        </button>
                    </form>
                </li>
            }
        </ul>
    }
}
