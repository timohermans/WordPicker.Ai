@page
@model WordPicker.Web.Pages.WordLists.DeleteModel
@{
    ViewData["Title"] = "Delete Word List";
}

<h1>Delete Word List</h1>

@if (Model.WordList != null)
{
    <div class="alert alert-warning" role="alert">
        <h4>Are you sure you want to delete this list?</h4>
        <p class="mb-0"><strong>@Model.WordList.Name</strong></p>
        <p class="text-muted">This will also delete all words in this list. This action cannot be undone.</p>
    </div>

    <form method="post">
        <input type="hidden" asp-for="WordList!.Id" />
        <button type="submit" class="btn btn-danger">Delete</button>
        <a asp-page="./Index" class="btn btn-secondary">Cancel</a>
    </form>
}
