@page
@model WordPicker.Web.Pages.WordLists.PickModel
@{
    ViewData["Title"] = "Pick Words";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Pick Words</h1>
    <a asp-page="./Index" class="btn btn-outline-secondary">Back to Lists</a>
</div>

@if (!Model.WordLists.Any())
{
    <div class="alert alert-info">
        <p>No word lists available. Create one first!</p>
    </div>
}
else if (!Model.ShowResults)
{
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="list-group mb-4">
            @for (int i = 0; i < Model.WordLists.Count; i++)
            {
                <label class="list-group-item list-group-item-action d-flex align-items-center gap-3">
                    <input type="checkbox" name="SelectedListIds" value="@Model.WordLists[i].Id" class="form-check-input flex-shrink-0" />
                    <span>@Model.WordLists[i].Name</span>
                </label>
            }
        </div>
        <button type="submit" class="btn btn-primary">Pick Words</button>
    </form>
}
else
{
    <div class="list-group mb-4">
        @foreach (var result in Model.Results)
        {
            <div class="list-group-item">
                <strong>@result.ListName</strong>
                <br />
                @if (result.Word != null)
                {
                    <span class="fs-5">@result.Word</span>
                }
                else
                {
                    <span class="text-muted">No words in this list.</span>
                }
            </div>
        }
    </div>
    <a asp-page="./Pick" class="btn btn-primary">Pick Again</a>
}
